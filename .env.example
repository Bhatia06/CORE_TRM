# CORE Session Recommender - Environment Variables
# Copy to .env and modify as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model Configuration
MODEL_TYPE=core_ave          # core_ave or core_trm
MODEL_SEED=42
MODEL_CHECKPOINT_DIR=checkpoints

# Data Paths
DATA_DIR=data/processed
ITEM_MAPPING_PATH=data/processed/item_mapping.json
RAW_DATA_PATH=data/raw/diginetica.csv

# Training Hyperparameters (override via CLI args)
BATCH_SIZE=2048
LEARNING_RATE=0.001
MAX_EPOCHS=100
EMBEDDING_DIM=100
MAX_SEQ_LEN=50
MARGIN=0.07
ITEM_DROPOUT=0.1

# Device
DEVICE=cuda                  # cuda or cpu
USE_AMP=true                 # mixed precision

# Frontend
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Seeds for reproducibility
SEEDS=42,123,456